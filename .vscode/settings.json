{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests", "-q"],
  "python.analysis.extraPaths": ["${workspaceFolder}"],
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "editor.rulers": [120],
  "[python]": { "editor.tabSize": 4, "editor.insertSpaces": true },
  "[javascript]": { "editor.tabSize": 2, "editor.insertSpaces": true },
  "[css]": { "editor.tabSize": 2, "editor.insertSpaces": true },
  "[html]": { "editor.tabSize": 2, "editor.insertSpaces": true },
  "files.exclude": { "**/__pycache__": true, "**/.pytest_cache": true },
  "files.associations": { "*.html": "html" },
  "search.exclude": { "instance/**": true, "source_images/**": true }
}
