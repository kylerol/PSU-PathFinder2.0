{
  "version": "2.0.0",
  "tasks": [
    { "label": "Install requirements", "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe -m pip install -r requirements.txt -r requirements-dev.txt",
      "problemMatcher": [] },
    { "label": "Run tests", "type": "shell", "command": "${workspaceFolder}/.venv/Scripts/python.exe -m pytest tests -q",
      "group": { "kind": "test", "isDefault": true }, "problemMatcher": [] },
    { "label": "Audit map annotations", "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe prepare_map.py --audit", "problemMatcher": [] },
    { "label": "Back up the local database", "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe database.py --backup backups/psu_pathfinder-backup.db",
      "problemMatcher": [] }
  ]
}
