# Names of the environment variables PSU PathFinder reads.
# On Render they are set in the service's "Environment" page (render.yaml fills most of them).
# NEVER commit real values. .env is listed in .gitignore.
# On your own computer none of them are required.

# Where SQLite lives. On Render this MUST be on the persistent disk (mount path /var/data).
DATABASE_PATH=/var/data/psu_pathfinder.db

# Long random string, e.g. output of:  python -c "import secrets; print(secrets.token_hex(32))"
# (render.yaml asks Render to generate one automatically.)
SECRET_KEY=change-me

# Needed in the X-Admin-Token header to re-import data, clear history or download a backup.
ADMIN_TOKEN=change-me-too

# Never 1 in production.
FLASK_DEBUG=0

# 1 when running behind Render's HTTPS proxy.
TRUST_PROXY=1

# PORT is set automatically by Render; do not set it yourself.
